# Düzelt — site üzerinden geri bildirim için sunucu ayarları
# Yerel ayarlar; üretim için duzelt-site Worker'ının secrets bölümüne aktarılır.
# Bu dosya Git dışında ve yalnız dosya sahibinin erişebildiği 0600 izniyle tutulur.
# Site varlıklarına, Chrome eklenti ZIP'ine veya derleme çıktısına kopyalanmaz.
# Gerçek şifre/anahtarları yalnız bu yerel .env dosyasına girin; paylaşmayın.
# SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER ve SMTP_PASSWORD değerlerini sağlayıcınızdan alın.
# Değerde # veya boşluk varsa değeri tırnak içine alın.
# .env.example paylaşılabilir şablondur; gerçek sırları oraya yazmayın.

# E-posta sağlayıcınızın verdiği SMTP sunucusu. Tahmin edilerek doldurulmaz.
SMTP_HOST=

# Sağlayıcının bildirdiği port. Genellikle 465 doğrudan TLS, 587 STARTTLS; doğrulayarak girin.
SMTP_PORT=

# Doğrudan TLS için true; zorunlu STARTTLS için false. Seçim sağlayıcınızın port/yöntemiyle eşleşmeli.
SMTP_SECURE=

# Zorunlu TLS: true olarak bırakın. Sertifika doğrulaması her bağlantıda zorunludur.
SMTP_REQUIRE_TLS=true

# Oluşturduğunuz gönderici hesabının SMTP kullanıcı adı. Sunucunuzun verdiği değeri kullanın.
SMTP_USER=

# SMTP şifresi veya sağlayıcının verdiği uygulama şifresi. Sohbete veya komut çıktısına yazmayın.
SMTP_PASSWORD=

# Önerilen gönderen adresi. Önce hesabı oluşturun; SMTP hesabınızın bu adresten göndermeye yetkili olması gerekir.
MAIL_FROM=duzelt@yerli.dev

# Bildirimlerin sabit alıcısı. İsterseniz bu değeri değiştirin; ikinci aşamada sizin değeriniz korunur.
MAIL_TO=iletisim@mehmetyerli.com

# Yalnız duzelt.yerli.dev için oluşturulan üretim widgetının herkese açık anahtarı.
TURNSTILE_SITE_KEY=

# Aynı widgetın özel anahtarı; yalnız sunucu secret mekanizmasına aktarılır.
TURNSTILE_SECRET_KEY=

# IP hız anahtarlarının HMAC özeti için en az 32 karakter rastgele değer.
# Sunucuya secret olarak aktarılır; tarayıcıya gönderilmez.
FEEDBACK_IP_HASH_KEY=
